su -
apt install -y sudo
usermod -aG sudo yakov
reboot

sudo apt update
sudo apt upgrade -y

sudo apt purge -y \
  gnome-contacts \
  gnome-weather \
  gnome-maps \
  gnome-music \
  gnome-calendar \
  gnome-characters \
  gnome-tour \
  gnome-connections \
  gnome-sound-recorder \
  gnome-software \
  shotwell \
  seahorse \
  malcontent \
  malcontent-gui \
  libreoffice* \
  yelp \
  evolution \
  evolution-common \
  evolution-plugins \
  simple-scan \
  firefox-esr

sudo apt autoremove --purge -y
sudo apt clean
sudo reboot

sudo apt install -y \
  alacritty \
  vim \
  tree \
  git \
  curl \
  ca-certificates \
  gnupg \
  unzip \
  tar \
  openssh-server \
  qemu-guest-agent \
  spice-vdagent \
  usbutils \
  v4l-utils \
  pipewire \
  wireplumber \
  xdg-desktop-portal \
  xdg-desktop-portal-gnome \
  gnome-tweaks \
  flatpak \
  xdg-desktop-portal \
  xdg-desktop-portal-gnome
  python3-venv \
  python3-pip \
  pipx \
  ntfs-3g \
  exfatprogs \
  rsync \
  wl-clipboard \
  postgresql-client

sudo reboot

# pgadmin
sudo apt update
sudo apt install -y curl ca-certificates gnupg lsb-release

sudo install -d -m 0755 /etc/apt/keyrings

curl -fsS https://www.pgadmin.org/static/packages_pgadmin_org.pub \
  | sudo gpg --dearmor -o /etc/apt/keyrings/packages-pgadmin-org.gpg

sudo chmod 644 /etc/apt/keyrings/packages-pgadmin-org.gpg

sudo sh -c 'echo "deb [signed-by=/etc/apt/keyrings/packages-pgadmin-org.gpg] https://ftp.postgresql.org/pub/pgadmin/pgadmin4/apt/$(lsb_release -cs) pgadmin4 main" > /etc/apt/sources.list.d/pgadmin4.list'

sudo apt update
sudo apt install -y pgadmin4-desktop

# docker
sudo apt remove $(dpkg --get-selections docker.io docker-compose docker-doc podman-docker containerd runc | cut -f1)

# Add Docker's official GPG key:
sudo apt update
sudo apt install ca-certificates curl
sudo install -m 0755 -d /etc/apt/keyrings
sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
sudo chmod a+r /etc/apt/keyrings/docker.asc

# Add the repository to Apt sources:
sudo tee /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/debian
Suites: $(. /etc/os-release && echo "$VERSION_CODENAME")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

sudo apt update

sudo apt install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
sudo systemctl status docker

sudo groupadd docker
sudo usermod -aG docker $USER
newgrp docker

flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak remote-modify --enable flathub

flatpak install -y flathub com.mattjakeman.ExtensionManager
flatpak install -y flathub net.waterfox.waterfox
flatpak install -y flathub com.obsproject.Studio
flatpak install -y flathub org.onlyoffice.desktopeditors
flatpak install -y flathub md.obsidian.Obsidian

# environment - cd in /home/yakov/repos/silverblue-dotfiles
gsettings set org.gnome.desktop.interface enable-animations false

cp -v ./bash/.bashrc ~/.bashrc
cp -v ./bash/.dircolors ~/.dircolors

mkdir -p ~/.local/share/fonts
cp -rv ./fonts/* ~/.local/share/fonts/
fc-cache -f -v

mkdir -p ~/.config/alacritty
cp -rv ./alacritty/* ~/.config/alacritty/

mkdir -p ~/.config/tmux
cp -rv ./tmux/* ~/.config/tmux/

cp -v ./vim/.vimrc ~/.vimrc 2>/dev/null || true

mkdir -p ~/.config/fastfetch
cp -v ./fastfetch/config.jsonc ~/.config/fastfetch

mkdir -p ~/.config/k9s
cp -rv ./k9s/* ~/.config/k9s/ 2>/dev/null || true

mkdir -p ~/Pictures
cp -rv ./pics/* ~/Pictures/

mkdir -p ~/.config/pipewire/pipewire.conf.d
cp ./sound/10-vm-audio.conf.conf ~/.config/pipewire/pipewire.conf.d
systemctl --user restart pipewire pipewire-pulse wireplumber

dconf load /org/gnome/desktop/wm/keybindings/ < ./keybinds/wm-keys.txt
dconf load /org/gnome/settings-daemon/plugins/media-keys/ < ./keybinds/media-keys.txt
dconf load /org/gnome/mutter/keybindings/ < ./keybinds/mutter-keys.txt
dconf load /org/gnome/mutter/wayland/keybindings/ < ./keybinds/mutter-wayland-keys.txt
dconf load /org/gnome/shell/keybindings/ < ./keybinds/shell-keys.txt

# cli tools
mkdir -p ~/.local/bin
curl https://mise.run | MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh
export PATH="$HOME/.local/bin:$PATH"
source ~/.bashrc
cd ~
# common
mise use -g tmux@latest
mise use -g btop@latest
mise use -g fastfetch@latest
mise use -g lazygit@latest
mise use -g hunk@latest

# ai
mise use -g herdr@latest
mise use -g opencode@latest

# devops
mise use -g kubectl@latest
mise use -g helm@latest
mise use -g k9s@latest
mise use -g kubectx@latest
mise use -g jq@latest
mise use -g yq@latest
mise use -g trivy@latest
mise use -g terraform@latest
mise use -g opentofu@latest
mise use -g ansible@latest
mise use -g shellcheck@latest
mise use -g hadolint@latest
mise use -g oras@latest

# update
flatpak update -y
mise upgrade

sudo apt purge -y \
  gnome-terminal \
  gnome-console \
  kgx

sudo apt autoremove --purge -y
sudo apt clean
